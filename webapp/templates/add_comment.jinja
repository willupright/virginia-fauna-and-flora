{% extends "appbuilder/base.html" %}
{% block content %}
<h2>
Add a Comment for {{ species.common_name }} observed on {{ observation.date_time.strftime('%Y-%m-%d') }}
            at {{ observation.date_time.strftime('%H:%M') }}</h2>

<form method="POST">
    {{ form.csrf_token }}
    <div class="form-group">
        {{ form.f_comment_text.label }}
        {{ form.f_comment_text(class="form-control") }}
        {% for error in form.f_comment_text.errors %}
            <span class="text-danger">{{ error }}</span>
        {% endfor %}
    </div>

    <button type="submit" class="btn btn-primary">Submit Comment</button>
</form>
{% endblock %}
