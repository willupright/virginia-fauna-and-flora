{% extends "appbuilder/base.html" %}
{% block head_css %}
{# NOTE: Flask-AppBuilder v5 still uses Bootstrap 3.4 #}
{{ super() }}
<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{{ url_for('static', filename='css/custom.css') }}">

<link
    href="https://fonts.googleapis.com/css2?family=Jomhuria&family=Poppins:ital,wght@0,100..900;1,100..900&display=swap"
    rel="stylesheet">

<style>
    body {
        font-family: 'Poppins', sans-serif;
        text-align: center;
        background-color: #FFFCF2;
        padding: 0;
        margin: 0;
    }

    h1 {
        font-family: 'Jomhuria', cursive;
        font-size: 4rem;
        font-weight: 400;
        letter-spacing: 1px;
        /* adds spacing between letters */
    }

    h3 {
        color: #103504;
    }

    .jumbotron {
        background-color: #103504;
        color: #D5CDAB;
    }

    .start-exploring-button a,
    .view-observations-button a,
    .select-cty-button.btn-link-button {
        color: inherit !important;
        text-decoration: none;
    }

    .start-exploring-button, .view-observations-button {
        font-size: 20px;
        font-family: "Exo 2", sans-serif;
        font-weight: bold;
        border-radius: 50px;
        border: 0px;
        background-color: #103504;
        color: #D5CDAB;
        padding: 10px;
        padding-left: 20px;
        padding-right: 20px;
        transition: transform 0.5s;
    }

    .start-exploring-button:hover, .view-observations-button:hover {
        transform: scale(1.1);
    }

    .select-cty-button {
        font-size: 20px;
        font-family: "Exo 2", sans-serif;
        font-weight: bold;
        border-radius: 50px;
        border: 0px;
        background-color: #D5CDAB;
        color: #103504;
        padding: 10px;
        padding-left: 20px;
        padding-right: 20px;
    }

    .dropdown {
        position: relative;
        display: inline-block;
    }

    .dropdown-menu {
        max-height: 400px;
        overflow-y: auto;
        left: 50% !important;
        transform: translateX(-50%);
        text-align: center;
        background-color: #D5CDAB;
        border-radius: 10px;
        border: none;
    }

    .dropdown-menu>li>a {
        color: #103504;
        font-family: "Exo 2", sans-serif;
        font-weight: bold;
        padding: 10px 20px;
    }

    .dropdown-menu>li>a:hover {
        background-color: #a39b78;
        color: #103504;
    }

    .jumbotron #about a {
        display: inline-block;
        font-size: 18px;
        font-family: "Exo 2", sans-serif;
        font-weight: bold;
        padding: 8px 20px;
        border-radius: 50px;
        background-color: #D5CDAB;
        color: #103504;
        font-weight: bold;
        text-decoration: none;
        transition: color 0.3s;
    }

    .navbar-brand a {
        font-weight: bold;
        text-decoration: none;
        color: #103504;
    }

    .jumbotron #about a:hover {
        background-color: #D5CDAB;
        color: #a39b78;
    }

    .jumbotron #about-us:hover {
        color: #103504;
    }

    .container,
    .container-fluid {
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

    #startExploring {
        text-decoration: none;
        color: #103504;
    }

    #startExploring:hover {
        color: #a39b78;
    }

    {
        # -------- ADJUSTING LUMEN.CSS ----------- #
    }

    span>.navbar-header {
        color: red;
    }
    .navbar {
        background-color: #D5CDAB;
        color: #FFFCF2;
        padding-left: 50px;
        padding-right: 30px;
        padding-top: 15px;
        margin-bottom: 0;
        padding-bottom: 0;
        border:none;
    }

    .dropdown-toggle {
        color: #103504 !important;
    }

    .container {
        width: 100%;
        margin: 10px 0;
        margin-top: 0;
    }
</style>
{% endblock %}
{% block content %}
<div class="jumbotron">
    <h1>VIRGINIA</h1>
    <h1>Flora & Fauna</h1>
    <p id="about"><a href="about">About Us</a></p>
</div>

<button class="select-cty-button"><a id="startExploring" href="species/list/">START EXPLORING</a></button>
<h3>OR</h3>
<div class="dropdown">
    <button class="select-cty-button" type="button" id="countyDropdown" data-toggle="dropdown">
        SELECT YOUR COUNTY <i class="fas fa-angle-down"></i>
    </button>
    <ul class="dropdown-menu">
        {% for county in counties %}
        <li>
            <a href="{{ url_for('SpeciesView.list') }}?_flt_0_counties={{ county.county_id }}">
                {{ county.name }}
            </a>
        </li>
        {% endfor %}
    </ul>
</div>

<div style="margin: 20px;">
    <button class="start-exploring-button">
        <a href="{{ url_for('ObservationFormView.this_form_get') }}">
            Returning User? Add an Observation
        </a>
    </button>
</div>

<div style="margin: 20px;">
    <button class="view-observations-button">
        <a href="{{ url_for('ObservationsListView.list') }}">
            See Observations
        </a>
    </button>
</div>
{% endblock %}