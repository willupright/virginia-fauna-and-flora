{% extends "appbuilder/base.html" %}

{% block content %}
<h1>{{ title }}</h1>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            {% for col in columns %}
                <th>{{ col.replace('_', ' ').title() }}</th>
            {% endfor %}
        </tr>
    </thead>
    <tbody>
        {% for item in items %}
        <tr>
            {% for col in columns %}
                <td>
                    {% if item[col] is defined %}
                        {{ item[col] }}
                    {% else %}
                        {{ '' }}
                    {% endif %}
                </td>
            {% endfor %}
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}
